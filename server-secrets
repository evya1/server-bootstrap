#!/usr/bin/env bash
# Manage the API keys that every login shell loads.
set -Eeuo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SELF")" && pwd -P)"
SB_LOG_PREFIX=server-secrets

for candidate in "$ROOT/lib/core.sh" /usr/local/lib/server-bootstrap/lib/core.sh; do
    # shellcheck source=lib/core.sh
    [[ -f "$candidate" ]] && source "$candidate" && break
done
for candidate in "$ROOT/lib/secrets-load.sh" /usr/local/lib/server-bootstrap/lib/secrets-load.sh; do
    # shellcheck source=lib/secrets-load.sh
    [[ -f "$candidate" ]] && source "$candidate" && break
done
command -v server_secrets_load >/dev/null 2>&1 \
    || { echo "server-secrets: lib/secrets-load.sh not found" >&2; exit 1; }

for candidate in "$ROOT/examples/secrets.env.example" \
    /usr/local/lib/server-bootstrap/examples/secrets.env.example; do
    [[ -f "$candidate" ]] && { SECRETS_TEMPLATE="${SECRETS_TEMPLATE:-$candidate}"; break; }
done
SECRETS_TEMPLATE="${SECRETS_TEMPLATE:-}"
FILE="$(server_secrets_path)"

usage() {
    cat <<'USAGE'
Usage: server-secrets [COMMAND]

  status        Masked list of the keys this machine knows about (default)
  set NAME      Prompt for one key and store it, without touching shell history
  edit          Open the keys file in $EDITOR, then re-check permissions
  check         Exit non-zero when no key is set
  path          Print the keys file path
  init          Create the keys file from the template when it does not exist

The file is /root/.config/server-bootstrap/secrets.env (mode 0600) unless
SERVER_SECRETS_FILE says otherwise. Values are parsed, never executed.
USAGE
}

secrets_init() {
    local directory
    directory="$(dirname -- "$FILE")"
    mkdir -p -- "$directory"
    chmod 0700 -- "$directory"
    if [[ -e "$FILE" ]]; then
        chmod 0600 -- "$FILE"
        return 0
    fi
    if [[ -n "$SECRETS_TEMPLATE" && -f "$SECRETS_TEMPLATE" ]]; then
        install -m 0600 "$SECRETS_TEMPLATE" "$FILE"
    else
        printf '%s\n' 'ANTHROPIC_API_KEY=' 'OPENAI_API_KEY=' 'OPENROUTER_API_KEY=' > "$FILE"
        chmod 0600 -- "$FILE"
    fi
    printf 'created %s\n' "$FILE"
}

secrets_set() {
    local name="$1" value temp
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
        || { echo "server-secrets: invalid variable name: $name" >&2; return 2; }
    secrets_init >/dev/null
    printf 'Paste the value for %s (input hidden): ' "$name" >&2
    IFS= read -rs value || true
    printf '\n' >&2
    [[ -n "$value" ]] || { echo "server-secrets: empty value, nothing written" >&2; return 1; }
    case "$value" in
        *$'\n'|*$'\r') echo "server-secrets: value must be a single line" >&2; return 1 ;;
    esac

    # Replace an existing entry in place, commented or not, so the template's
    # ordering and comments survive.
    temp="$(mktemp)"
    chmod 0600 -- "$temp"
    if grep -Eq "^[[:space:]]*#?[[:space:]]*(export[[:space:]]+)?$name=" "$FILE"; then
        awk -v name="$name" -v value="$value" '
            $0 ~ "^[[:space:]]*#?[[:space:]]*(export[[:space:]]+)?" name "=" {
                if (!done) { print name "=" value; done = 1 }
                next
            }
            { print }
        ' "$FILE" > "$temp"
    else
        cat "$FILE" > "$temp"
        printf '%s=%s\n' "$name" "$value" >> "$temp"
    fi
    cat "$temp" > "$FILE"
    rm -f -- "$temp"
    chmod 0600 -- "$FILE"
    printf 'stored %s in %s\n' "$name" "$FILE"
    printf 'run "aikeys on" or open a new shell to pick it up\n'
}

secrets_edit() {
    secrets_init >/dev/null
    "${EDITOR:-${VISUAL:-vi}}" "$FILE"
    chmod 0600 -- "$FILE"
    # Parsing in a subshell reports bad lines without polluting this process.
    ( server_secrets_load "$FILE" >/dev/null )
    server_secrets_status "$FILE"
}

secrets_check() {
    local loaded
    loaded="$( ( server_secrets_load "$FILE" >/dev/null 2>&1; printf '%s' "${SERVER_SECRETS_LOADED:-}" ) )"
    if [[ -z "$loaded" ]]; then
        echo "server-secrets: no key is set in $FILE" >&2
        return 1
    fi
    printf 'keys set: %s\n' "$loaded"
}

case "${1:-status}" in
    status) server_secrets_status "$FILE" ;;
    set) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; secrets_set "$2" ;;
    edit) secrets_edit ;;
    check) secrets_check ;;
    path) printf '%s\n' "$FILE" ;;
    init) secrets_init ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
