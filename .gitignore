# Build output. release/build-release.sh deletes and regenerates this directory
# on every run; the archives belong on a GitHub Release, not in git history.
release/dist/

# Stray archives downloaded or built outside release/dist.
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.txz
*.zip

*.log
.DS_Store

# Local credentials and secret-bearing configuration. Example templates below
# are explicitly re-included so they remain visible and reviewable.
.env
.env.*
*.env
*.env.*
!config.example.env
!examples/*.env.example
credentials/
secrets/
*.token
*.tokens
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
.npmrc
.pypirc
.netrc
.aws/credentials
.gcp/application_default_credentials.json
.azure/accessTokens.json
.docker/config.json
.kube/config
kubeconfig*
*.tfstate
*.tfstate.*
config/*.local
config/*.local.*
config/*.secret
config/*.secret.*

# checksums/SHA256SUMS is intentionally NOT ignored: it ships inside the
# release archive and is regenerated by build-release.sh before packaging.
