# server-bootstrap 2.2.3 - API keys for the installed coding agents.
#
# Installed to /root/.config/server-bootstrap/secrets.env with mode 0600 and
# loaded into every login shell. Paste a key after the "=", no quotes needed,
# then open a new shell or run "aikeys on".
#
#   server-secrets set OPENROUTER_API_KEY   # prompt, nothing reaches history
#   server-secrets edit                     # open this file in $EDITOR
#   server-secrets status                   # masked list of what is set
#
# WARNING: while ANTHROPIC_API_KEY or OPENAI_API_KEY is set, "claude" and
# "codex" bill per token through the API instead of using a Claude Pro/Max or
# ChatGPT subscription login. Run "aikeys off" for subscription mode.
#
# A name left empty is not exported, so an untouched placeholder cannot be
# mistaken for a configured credential.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Uncomment what you use. Names match the provider table pi reads.
# GEMINI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# HF_TOKEN=

# Prefer "gh auth login" over a long-lived token here.
# GITHUB_TOKEN=
