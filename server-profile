#!/usr/bin/env bash
# Install an optional profile that ships inside this release. A profile is
# never enabled by the bootstrap itself: only by this command, or by
# enable_profile in a provision plan, which runs this command.
set -Eeuo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SELF")" && pwd -P)"
PROFILES_ROOT="$ROOT/profiles"

usage() {
    cat <<'USAGE'
Usage: server-profile install NAME [PROFILE_OPTIONS...]
       server-profile list

Run `server-profile install NAME --help` for a profile's options.
USAGE
}

available() {
    local installer
    for installer in "$PROFILES_ROOT"/*/install.sh; do
        [[ -f "$installer" ]] && basename -- "$(dirname -- "$installer")"
    done
    return 0
}

case "${1:-}" in
    list)
        available ;;
    install)
        name="${2:-}"
        [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] \
            || { echo "ERROR: install needs a profile name" >&2; usage >&2; exit 2; }
        [[ -f "$PROFILES_ROOT/$name/install.sh" ]] || {
            echo "ERROR: no profile named '$name' in this release; available: $(available | paste -sd' ' -)" >&2
            exit 2
        }
        shift 2
        exec bash "$PROFILES_ROOT/$name/install.sh" "$@" ;;
    -h|--help)
        usage ;;
    *)
        usage >&2; exit 2 ;;
esac
