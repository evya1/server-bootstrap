# server-bootstrap 2.2.1 — optional environment overrides.

# WORKSPACE_ROOT=/workspace
# RUN_APT_UPGRADE=0
# INSTALL_ZSH=1
# INSTALL_OH_MY_ZSH=1
# INSTALL_NODEJS=1
# INSTALL_CLAUDE_CODE=1
# INSTALL_CODEX=1
# INSTALL_PI=1
# INSTALL_VSCODE_EXTENSIONS=1
# INSTALL_UV=1
# INSTALL_GITHUB_CLI=1
# INSTALL_BASE_PYTHON_ENV=1
# INSTALL_RUNTIME_TOOLS=1
# INSTALL_SECRETS_FILE=1
# RUN_ACCEPT_TEST=1        # 0, 1, or strict

# Distribution packages come from config/packages.txt. Point PACKAGES_FILE at
# your own manifest, or adjust the shipped one without editing it.
# PACKAGES_FILE=/usr/local/lib/server-bootstrap/config/packages.txt
# EXTRA_PACKAGES="postgresql-client redis-tools"
# SKIP_PACKAGES="nmap tcpdump"

# Acceptance thresholds. Accelerator checks run only when nvidia-smi exists;
# set REQUIRE_ACCELERATOR=1 to reject a machine that has no GPU at all.
# REQUIRE_ACCELERATOR=0
# MIN_CORES=0
# MIN_RAM_GB=0
# MIN_DISK_GB=50
# MIN_DISK_MBPS=100
# MIN_VRAM_MIB=0
# MIN_PCIE_WIDTH=8
# MIN_PCIE_GEN=3
# MAX_TEMP_C=85

# BASE_PYTHON_ENV=/workspace/venvs/base-python
# BASE_PYTHON_PACKAGES=numpy

# --- Tracking upstream instead of the pins below ---------------------------
# Every version variable in this file also accepts the literal "latest". The
# bootstrap then resolves the current release and takes its SHA-256 from the
# publisher's own checksum manifest, so the download is still verified before
# it is extracted. That manifest comes from the same origin as the artifact,
# which proves integrity, not authenticity — a pinned version plus a checksum
# you reviewed is the stronger claim, and stays the default.
# Run tools/refresh-pins.sh --check to see how far behind the pins are.
#
#   NODE_VERSION=latest             # newest LTS from nodejs.org
#   GH_VERSION=latest               # newest cli/cli release
#   UV_VERSION=latest               # newest astral-sh/uv release
#   CLAUDE_CODE_VERSION=latest      # npm dist-tag
#   CODEX_VERSION=latest            # npm dist-tag
#   PI_VERSION=latest               # npm dist-tag
#   OH_MY_ZSH_REF=latest            # current master commit

# Verified uv archive, per architecture.
# UV_VERSION=0.12.12
# UV_SHA256_X64=ab9b309d4586403f024e100abaceb396616e178a553e2500c36087d180f09509
# UV_SHA256_ARM64=fe08db50cc1b56cd1da7801065ed1103d27ed3f9571cd122386cfc7faf1b8df5

# Oh My Zsh is enabled by default at an exact upstream commit. With an empty
# checksum, the bootstrap fetches that commit through Git and verifies HEAD.
# Set a SHA-256 to use the matching GitHub source archive instead.
# OH_MY_ZSH_REF=cd320b5506998f32284d37799592cb2ba43a3188
# OH_MY_ZSH_SHA256=
# OH_MY_ZSH_THEME=robbyrussell
# OH_MY_ZSH_PLUGINS=git

# Node.js LTS is downloaded from nodejs.org and verified per architecture.
# NODE_VERSION=24.21.0
# NODE_SHA256_X64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
# NODE_SHA256_ARM64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
# NODE_INSTALL_ROOT=/opt/nodejs

# GitHub CLI, from the pinned upstream release rather than apt.
# GH_VERSION=2.100.0
# GH_SHA256_X64=e4d4bb4498e8d007abe545b6568926793ace1b6447da598294a610018cb164be
# GH_SHA256_ARM64=ea4e7a581a32ccad6cc7923cb1576ac5859ba4b9a16ab22eb8f8a96e78e2e961

# Exact npm versions for the coding-agent CLIs.
# AI_CLI_PREFIX=/opt/ai-cli
# NPM_REGISTRY=https://registry.npmjs.org/
# CLAUDE_CODE_VERSION=2.1.267
# CLAUDE_CODE_DISABLE_AUTOUPDATER=1
# CODEX_VERSION=0.154.0
# PI_VERSION=0.85.1

# pi reads custom providers from models.json. The shipped template is installed
# only when that file does not already exist, so your edits are never replaced.
# PI_CONFIG_DIR=/root/.pi/agent
# INSTALL_PI_MODELS_TEMPLATE=1
# PI_MODELS_TEMPLATE=/usr/local/lib/server-bootstrap/examples/pi-models.example.json

# One root-only file holds every provider API key, and the generated Zsh
# startup configuration loads it into each login shell. Manage it with
# server-secrets; toggle it inside a shell with aikeys on|off.
# SECRETS_DIR=/root/.config/server-bootstrap
# SECRETS_FILE=/root/.config/server-bootstrap/secrets.env
# SECRETS_TEMPLATE=/usr/local/lib/server-bootstrap/examples/secrets.env.example

# Remote-SSH extensions. The bootstrap installs immediately when a VS Code
# Server CLI exists; otherwise the helper retries from the first VS Code shell.
# VSCODE_EXTENSIONS_FILE=/path/to/vscode-extensions.txt
# VSCODE_EXTENSIONS_STRICT=0
# VSCODE_EXTENSIONS_AUTO_RETRY_SECONDS=21600

# Legacy one-add-on interface. Prefer server-provision for multiple bundles.
# INSTALL_ADDON=0
# ADDON_NAME=
# ADDON_VERSION=
# ADDON_URL=
# ADDON_SHA256=
# ADDON_INSTALLER=install.sh
# ADDON_INSTALL_ARGS=
# ADDON_FORCE=0
# ADDON_ALLOW_LOCAL_FILE=0
